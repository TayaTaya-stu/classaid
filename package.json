{
  "name": "classaid",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "overlay": "electron overlay/main.cjs",
    "overlay:dist": "electron-builder --win portable"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "@supabase/supabase-js": "^2.108.2",
    "next": "16.2.9",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "electron": "44.9.0",
    "electron-builder": "^26.0.12",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "main": "overlay/main.cjs",
  "build": {
    "appId": "jp.classroom.commentoverlay",
    "productName": "Classroom Comment Overlay",
    "files": [
      "overlay/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "artifactName": "ClassroomCommentOverlay-${version}-portable.${ext}"
    }
  }
}
